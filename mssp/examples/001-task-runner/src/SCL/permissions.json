{
  "version": "1.0.0",
  "types": {
    "file.read": {
      "risk": "L0",
      "path_prefix": "data/"
    },
    "http.get": {
      "risk": "L1",
      "hosts": ["example.org", "example.com"]
    },
    "file.delete": {
      "risk": "L4",
